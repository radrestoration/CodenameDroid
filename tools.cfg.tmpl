# External tools for the Codename Droid build.
#
# Copy this file to tools.cfg (not checked in) and set what you need.
# Without tools.cfg - or for anything left unset - each tool is run by
# its plain name from your PATH. One NAME=value a line, no spaces around '='.

# cc65 (ca65, ld65). CC65_HOME is cc65's own variable; CA65/LD65 default
# to its bin/. An installed cc65 needs none of these.
#CC65_HOME=~/retro/emulators/cc65
#CA65=ca65
#LD65=ld65

# b-em, for `make run`
#BEM=./b-em
#BEM_DIR=~/retro/emulators/b-em

#PYTHON=python3

# the C64 port's loading screens are made from the original disc; the Makefile's default:
#DISC=~/retro/games/Disc032-CodenameDroidStrykersRun2.ssd
